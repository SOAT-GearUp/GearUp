# ---------------------------------------------------------------------------
# Credenciais do AWS Academy Learner Lab — MODELO
#
# ESCOPO: só credenciais da sessão do lab, que mudam a cada Start Lab.
# Configuração da infraestrutura (senha do banco, tipo de instância, nome do
# cluster...) fica em `terraform.tfvars` — ver terraform.tfvars.example.
#
# 1. Copie este arquivo para `infra/.env.aws` (já está no .gitignore).
# 2. No lab: Start Lab -> AWS Details -> AWS CLI -> Show.
# 3. Cole o bloco por cima das três primeiras linhas. O script aceita tanto
#    este formato (MAIÚSCULAS) quanto o formato original do lab
#    (`aws_access_key_id=...`, com ou sem a linha `[default]`).
# 4. Carregue com:
#      PowerShell  ->  . .\scripts\carregar-credenciais.ps1
#      bash/zsh    ->  source ./scripts/carregar-credenciais.sh
#
#    (Alternativa sem script: cole o mesmo bloco direto em ~/.aws/credentials.)
#
# As credenciais são temporárias (expiram junto com a sessão do lab, no máximo
# 4h). Ao expirar: Start Lab, recopie o bloco e rode o script de novo.
#
# NUNCA versione o arquivo `.env.aws` preenchido.
# ---------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=ASIA_SUBSTITUA
AWS_SECRET_ACCESS_KEY=SUBSTITUA
AWS_SESSION_TOKEN=SUBSTITUA

# Região fixa do projeto (o Learner Lab só libera us-east-1 e us-west-2).
AWS_DEFAULT_REGION=us-east-1

# ---------------------------------------------------------------------------
# NÃO coloque variáveis do Terraform aqui.
#
# O Terraform lê variáveis de ambiente com prefixo `TF_VAR_`, mas o
# `terraform.tfvars` tem precedência MAIOR e sobrescreveria o valor sem avisar.
# Para não haver dois lugares definindo a mesma coisa, a divisão é:
#   este arquivo      -> credenciais da sessão (AWS_*)
#   terraform.tfvars  -> configuração da infraestrutura (senha_banco, etc.)
# ---------------------------------------------------------------------------
