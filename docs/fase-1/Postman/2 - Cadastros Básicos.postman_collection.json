  "item": [
    {
      "name": "/api/autenticacao/login - Logar como Atendente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var response = pm.response.json();\r",
              "pm.environment.set(\"bearerToken\", response.accessToken);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "text/plain"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"atendente\",\n  \"senha\": \"atendente@123\"\n}",
          "options": {
            "raw": {
              "headerFamily": "json",
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/autenticacao/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "autenticacao",
            "login"
          ]
        }
      },
      "response": []
    },
