        {
          "listen": "test",
          "script": {
            "exec": [
              "var response = pm.response.json();\r",
              "pm.environment.set(\"bearerToken\", response.accessToken);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
